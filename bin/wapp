#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMAND="${1:-help}"
if [[ $# -gt 0 ]]; then shift; fi

usage(){
  cat <<'EOF'
Wapp Security Core

Usage:
  wapp emergency-clean DOMAIN
  wapp emergency-clean DOMAIN --execute
  wapp emergency-clean DOMAIN --reopen
  wapp closure-check DOMAIN
  wapp plugin-policy RECORD.json
  wapp signed-drift-diagnostic create|verify ...
  wapp volatile-runtime-disposition create|verify|policy-token ...
  wapp read-only-security-surface capture-verify|create|verify ...
  wapp product-seal [OUTPUT]
  wapp test
  wapp release-check
  wapp version

Emergency Operator Mode is human-operated and non-canonical. It never creates
provider authority, canonical READY, automatic CLEAN, or closure authority.
EOF
}

case "$COMMAND" in
  emergency-clean) exec /bin/bash "$SCRIPT_DIR/wapp-emergency-clean" "$@" ;;
  closure-check) exec /bin/bash "$SCRIPT_DIR/wapp-closure-check" "$@" ;;
  plugin-policy) exec /bin/bash "$SCRIPT_DIR/wapp-plugin-policy" "$@" ;;
  signed-drift-diagnostic) exec /bin/bash "$SCRIPT_DIR/wapp-signed-drift-diagnostic" "$@" ;;
  volatile-runtime-disposition) exec /bin/bash "$SCRIPT_DIR/wapp-volatile-runtime-disposition" "$@" ;;
  read-only-security-surface) exec /bin/bash "$SCRIPT_DIR/wapp-read-only-security-surface" "$@" ;;
  product-seal) exec /bin/bash "$SCRIPT_DIR/wapp-product-seal" "$@" ;;
  test) exec /bin/bash "$SCRIPT_DIR/wapp-test" "$@" ;;
  release-check) exec /bin/bash "$SCRIPT_DIR/wapp-release-check" "$@" ;;
  version) tr -d '[:space:]' < "$SCRIPT_DIR/../VERSION"; printf '\n' ;;
  help|-h|--help) usage ;;
  *) printf 'Unknown command: %s\n\n' "$COMMAND" >&2; usage >&2; exit 64 ;;
esac
