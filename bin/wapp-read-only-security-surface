#!/usr/bin/env bash
set -euo pipefail
umask 077
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.."&&pwd)"
MODEL="$ROOT/lib/read-only-security-surface.py"
RULESET="$ROOT/config/read-only-security-surface-ruleset.json"
source "$ROOT/lib/recovery-integrity.sh"
fail(){ printf 'read-only-security-surface: %s\n' "$1" >&2;exit 20; }
PYTHON="$(recovery_trusted_fixed_python)"||fail 'trusted local Python unavailable'
COMMIT="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null)";VERSION="$(tr -d '[:space:]'<"$ROOT/VERSION")"
signed(){ [[ "$1" == /*&&-f "$1"&&! -L "$1"&&-f "$1.hmac"&&! -L "$1.hmac" ]]&&recovery_verify_file "$1" "$1.hmac"; }
publish(){
  local staged="$1" output="$2"
  recovery_sign_file "$staged" "$staged.hmac" >/dev/null||fail 'artifact signing failed'
  [[ ! -e "$output"&&! -L "$output"&&! -e "$output.hmac"&&! -L "$output.hmac" ]]||fail 'output collision'
  mv "$staged" "$output";mv "$staged.hmac" "$output.hmac"
}
case "${1:-}" in
  capture-create)
    [[ $# -eq 11&&"${2:-}" == --inventory-rows&&"${4:-}" == --observed-at&&"${6:-}" == --expires-at&&"${8:-}" == --capture-nonce&&"${10:-}" == --output ]]||fail 'invalid capture-create invocation'
    rows="$3";observed="$5";expires="$7";nonce="$9";output="${11}"
    [[ "$rows" == /*&&"$output" == /*&&-f "$rows"&&! -L "$rows" ]]||fail 'invalid capture paths'
    tmp="$(mktemp -d 2>/dev/null||mktemp -d -t wapp-security-surface)";trap 'rm -rf "$tmp"' EXIT
    PYTHONDONTWRITEBYTECODE=1 "$PYTHON" "$MODEL" capture-create "$rows" "$observed" "$expires" "$nonce" "$COMMIT" "$VERSION" "$tmp/capture.json"||fail 'capture binding failed'
    publish "$tmp/capture.json" "$output";trap - EXIT;rmdir "$tmp";printf 'READ_ONLY_NATIVE_CAPTURE_BINDING_CREATED: %s\n' "$output"
    ;;
  capture-verify)
    [[ $# -eq 3&&"${2:-}" == --artifact&&"${3:-}" == /* ]]||fail 'invalid capture-verify invocation'
    signed "$3"||fail 'capture signature invalid';PYTHONDONTWRITEBYTECODE=1 "$PYTHON" "$MODEL" capture-verify "$3"
    ;;
  create)
    [[ $# -eq 9&&"${2:-}" == --capture&&"${4:-}" == --provenance&&"${6:-}" == --generated-at&&"${8:-}" == --output ]]||fail 'invalid create invocation'
    capture="$3";provenance="$5";generated="$7";output="$9"
    [[ "$capture" == /*&&"$provenance" == /*&&"$output" == /* ]]||fail 'absolute artifact paths required'
    signed "$capture"||fail 'capture signature invalid';signed "$provenance"||fail 'provenance signature invalid'
    "$0" capture-verify --artifact "$capture" >/dev/null||fail 'capture contract invalid'
    tmp="$(mktemp -d 2>/dev/null||mktemp -d -t wapp-security-surface)";trap 'rm -rf "$tmp"' EXIT
    PYTHONDONTWRITEBYTECODE=1 "$PYTHON" "$MODEL" create "$capture" "$provenance" "$RULESET" "$generated" "$COMMIT" "$VERSION" "$tmp/surface.json"||fail 'surface derivation failed'
    publish "$tmp/surface.json" "$output";trap - EXIT;rmdir "$tmp";printf 'READ_ONLY_SECURITY_SURFACE_CREATED: %s\n' "$output"
    ;;
  verify)
    [[ $# -eq 3&&"${2:-}" == --artifact&&"${3:-}" == /* ]]||fail 'invalid verify invocation'
    signed "$3"||fail 'surface signature invalid';PYTHONDONTWRITEBYTECODE=1 "$PYTHON" "$MODEL" verify "$3"
    ;;
  *)fail 'usage: wapp-read-only-security-surface capture-create|capture-verify|create|verify';;
esac
