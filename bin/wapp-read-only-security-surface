#!/usr/bin/env bash
set -euo pipefail
umask 077
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.."&&pwd)"
MODEL="$ROOT/lib/read-only-security-surface.py"
RULESET="$ROOT/config/read-only-security-surface-ruleset.json"
NATIVE_POLICY="$ROOT/config/native-filesystem-helper.json"
source "$ROOT/lib/recovery-integrity.sh"
fail(){ printf 'read-only-security-surface: %s\n' "$1" >&2;exit 20; }
PYTHON="$(recovery_trusted_fixed_python)"||fail 'trusted local Python unavailable'
COMMIT="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null)";VERSION="$(tr -d '[:space:]'<"$ROOT/VERSION")"
signed(){ [[ "$1" == /*&&-f "$1"&&! -L "$1"&&-f "$1.hmac"&&! -L "$1.hmac" ]]&&recovery_verify_file "$1" "$1.hmac"; }
signed_dependencies(){
  local mode="$1" list path;shift
  list="$(mktemp 2>/dev/null||mktemp -t wapp-security-surface-dependencies)"||fail 'dependency list allocation failed'
  if ! PYTHONDONTWRITEBYTECODE=1 "$PYTHON" "$MODEL" "$mode" "$@" >"$list";then rm -f "$list";fail 'dependency contract invalid';fi
  while IFS= read -r path;do [[ -n "$path" ]]||continue;signed "$path"||{ rm -f "$list";fail 'signed dependency invalid'; };done <"$list"
  rm -f "$list"
}
publish(){
  local staged="$1" output="$2"
  recovery_sign_file "$staged" "$staged.hmac" >/dev/null||fail 'artifact signing failed'
  [[ ! -e "$output"&&! -L "$output"&&! -e "$output.hmac"&&! -L "$output.hmac" ]]||fail 'output collision'
  mv "$staged" "$output";mv "$staged.hmac" "$output.hmac"
}
case "${1:-}" in
  capture-verify)
    [[ $# -eq 3&&"${2:-}" == --artifact&&"${3:-}" == /* ]]||fail 'invalid capture-verify invocation'
    signed "$3"||fail 'capture signature invalid'
    signed_dependencies capture-dependencies "$3" "$COMMIT" "$VERSION" "$NATIVE_POLICY" "$RULESET"
    PYTHONDONTWRITEBYTECODE=1 "$PYTHON" "$MODEL" capture-verify "$3" "$COMMIT" "$VERSION" "$NATIVE_POLICY" "$RULESET"
    ;;
  create)
    [[ $# -eq 9&&"${2:-}" == --capture&&"${4:-}" == --provenance&&"${6:-}" == --generated-at&&"${8:-}" == --output ]]||fail 'invalid create invocation'
    capture="$3";provenance="$5";generated="$7";output="$9"
    [[ "$capture" == /*&&"$provenance" == /*&&"$output" == /* ]]||fail 'absolute artifact paths required'
    signed "$capture"||fail 'capture signature invalid';signed "$provenance"||fail 'provenance signature invalid'
    "$0" capture-verify --artifact "$capture" >/dev/null||fail 'capture contract invalid'
    signed_dependencies provenance-dependencies "$capture" "$provenance" "$COMMIT" "$VERSION" "$NATIVE_POLICY" "$RULESET"
    tmp="$(mktemp -d 2>/dev/null||mktemp -d -t wapp-security-surface)";trap 'rm -rf "$tmp"' EXIT
    PYTHONDONTWRITEBYTECODE=1 "$PYTHON" "$MODEL" create "$capture" "$provenance" "$RULESET" "$NATIVE_POLICY" "$generated" "$COMMIT" "$VERSION" "$tmp/surface.json"||fail 'surface derivation failed'
    publish "$tmp/surface.json" "$output";trap - EXIT;rmdir "$tmp";printf 'READ_ONLY_SECURITY_SURFACE_CREATED: %s\n' "$output"
    ;;
  verify)
    [[ $# -eq 3&&"${2:-}" == --artifact&&"${3:-}" == /* ]]||fail 'invalid verify invocation'
    signed "$3"||fail 'surface signature invalid'
    list="$(mktemp 2>/dev/null||mktemp -t wapp-security-surface-roots)"||fail 'dependency list allocation failed'
    PYTHONDONTWRITEBYTECODE=1 "$PYTHON" "$MODEL" surface-dependencies "$3" "$COMMIT" "$VERSION" "$NATIVE_POLICY" >"$list"||{ rm -f "$list";fail 'surface dependency contract invalid'; }
    exec 3<"$list";IFS= read -r capture <&3;IFS= read -r provenance <&3;exec 3<&-;rm -f "$list"
    signed "$capture"||fail 'capture signature invalid';signed "$provenance"||fail 'provenance signature invalid'
    signed_dependencies capture-dependencies "$capture" "$COMMIT" "$VERSION" "$NATIVE_POLICY" "$RULESET"
    signed_dependencies provenance-dependencies "$capture" "$provenance" "$COMMIT" "$VERSION" "$NATIVE_POLICY" "$RULESET"
    PYTHONDONTWRITEBYTECODE=1 "$PYTHON" "$MODEL" verify "$3" "$COMMIT" "$VERSION" "$NATIVE_POLICY"
    ;;
  *)fail 'usage: wapp-read-only-security-surface capture-verify|create|verify';;
esac
