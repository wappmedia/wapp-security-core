#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

/bin/bash -n wapp bin/wapp bin/wapp-closure-check bin/wapp-emergency-clean \
  bin/wapp-package-audit bin/wapp-plugin-policy bin/wapp-product-seal bin/wapp-public-data-boundary \
  bin/wapp-release-check bin/wapp-test lib/recovery-integrity.sh lib/native-displaced-inventory-loader.sh \
  lib/native-displaced-inventory-ephemeral-loader.sh native/build-displaced-inventory-helper.sh \
  native/build-ephemeral-memfd-launcher.sh tests/test-emergency-operator-v1.sh tests/test-external-reviewer-trust.sh \
  tests/test-file-manager-for-work-policy.sh tests/test-native-displaced-inventory-helper.sh \
  tests/test-native-displaced-inventory-reproducible-build.sh tests/test-native-ephemeral-bootstrap.sh tests/test-public-data-boundary.sh
python3 - <<'PY'
from pathlib import Path
for name in ("lib/emergency-operator-v1.py", "lib/plugin-policy.py", "tests/public-data-boundary.py"):
    compile(Path(name).read_text(encoding="utf-8"), name, "exec")
PY
/bin/bash tests/test-emergency-operator-v1.sh
/bin/bash tests/test-external-reviewer-trust.sh
/bin/bash tests/test-file-manager-for-work-policy.sh
/bin/bash tests/test-native-displaced-inventory-helper.sh
/bin/bash tests/test-native-displaced-inventory-reproducible-build.sh
/bin/bash tests/test-native-ephemeral-bootstrap.sh
/bin/bash tests/test-public-data-boundary.sh

printf 'PUBLIC_CORE_TESTS: PASS\n'
