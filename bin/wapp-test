#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

/bin/bash -n wapp bin/wapp bin/wapp-closure-check bin/wapp-emergency-clean \
  bin/wapp-package-audit bin/wapp-product-seal bin/wapp-public-data-boundary \
  bin/wapp-release-check bin/wapp-test lib/recovery-integrity.sh \
  tests/test-emergency-operator-v1.sh tests/test-public-data-boundary.sh
python3 - <<'PY'
from pathlib import Path
for name in ("lib/emergency-operator-v1.py", "tests/public-data-boundary.py"):
    compile(Path(name).read_text(encoding="utf-8"), name, "exec")
PY
/bin/bash tests/test-emergency-operator-v1.sh
/bin/bash tests/test-public-data-boundary.sh

printf 'PUBLIC_CORE_TESTS: PASS\n'
